# Telegram bot token from @BotFather (keep secret)
BOT_TOKEN=
# Numeric Telegram user ID allowed to control the bot
OWNER_ID=
# Target channel, e.g. @my_channel or -1001234567890
CHANNEL_ID=
# IANA timezone, e.g. Asia/Tashkent
TIMEZONE=Asia/Tashkent
# Number of queued videos to publish per day
POSTS_PER_DAY=3
# Local time (24h) for daily publishing window start/end
PUBLISH_START=10:00
PUBLISH_END=21:00
# Keep downloaded videos and SQLite DB on persistent storage
DATA_DIR=./data
# Optional: maximum download size in MB
MAX_VIDEO_MB=180
